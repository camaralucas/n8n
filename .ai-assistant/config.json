{
  "version": "0.1.0",
  "created_at": "2026-01-11T00:00:00Z",
  "settings": {
    "memory": {
      "max_session_history_entries": 1000,
      "context_retention_days": 30,
      "auto_save": true
    },
    "knowledge_base": {
      "embedding_model": "onnx/all-MiniLM-L6-v2",
      "vector_storage": "sqlite",
      "auto_index": false,
      "index_patterns": [
        "packages/**/*.ts",
        "packages/**/*.vue",
        "**/*.md"
      ],
      "exclude_patterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/*.test.ts",
        "**/*.spec.ts"
      ]
    },
    "rag": {
      "top_k_results": 5,
      "similarity_threshold": 0.7,
      "use_reranking": false
    },
    "learning": {
      "auto_learn_from_implementations": true,
      "pattern_detection_threshold": 3,
      "save_successful_implementations": true
    }
  },
  "paths": {
    "memory_dir": ".ai-assistant/memory",
    "knowledge_base_dir": ".ai-assistant/knowledge-base",
    "tasks_dir": ".ai-assistant/tasks",
    "logs_dir": ".ai-assistant/logs"
  },
  "metadata": {
    "repository": "n8n",
    "primary_language": "typescript",
    "framework": "monorepo",
    "package_manager": "pnpm"
  }
}
